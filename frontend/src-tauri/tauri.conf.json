{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDV Local",
  "version": "0.1.0",
  "identifier": "com.pdv.local",
  "build": {
    "beforeDevCommand": "pnpm dev -- --strictPort",
    "beforeBuildCommand": "pnpm desktop:prepare-backend && pnpm desktop:prepare-python && pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PDV Local",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/backend", "resources/python"]
  }
}